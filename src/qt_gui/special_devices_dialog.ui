     <item row="3" column="1"><widget class="QCheckBox" name="useSpecial3"/></item>
     <item row="3" column="2"><widget class="QComboBox" name="class3"/></item>
     <item row="3" column="3"><widget class="QCheckBox" name="legacy3"/></item>
     <item row="3" column="4">
      <layout class="QHBoxLayout" name="action3Layout">
       <item><widget class="QPushButton" name="probe3"><property name="text"><string>Probe...</string></property><property name="visible"><bool>false</bool></property></widget></item>

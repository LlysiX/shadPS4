   <item>
    <layout class="QHBoxLayout" name="bottomBtnLayout">
     <item><widget class="QPushButton" name="installUdevBtn">
      <property name="text"><string>Install Linux udev rules (one-time, requires password)</string></property>
     </widget></item>
     <item><widget class="QPushButton" name="refreshBtn">
      <property name="text"><string>Refresh detected kits</string></property>
      <property name="toolTip"><string>Re-scan kits and re-open devices for slots whose Legacy raw-HID flag changed.</string></property>
     </widget></item>
    </layout>

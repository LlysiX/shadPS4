     <item row="2" column="2"><widget class="QComboBox" name="class2"/></item>
     <item row="2" column="3"><widget class="QCheckBox" name="legacy2"/></item>
     <item row="2" column="4">
      <layout class="QHBoxLayout" name="action2Layout">
